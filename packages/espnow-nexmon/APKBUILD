# Contributor: slindauskands@gmail.com
# Pins documented in docs/pins.md - change them together.
pkgname=espnow-nexmon
pkgver=0.1.0
pkgrel=4
_kpkgver=6.12.85-r0		# linux-rpi package version
_krel=6.12.85-0-rpi		# matching kernel release (uname -r)
_drvcommit=fff319040f6a8034fce36f846cce2dc19de1b396	# kali brcmfmac-nexmon-dkms 6.12.2
_fwcommit=42e244621979ba96d82220a3324771d0b6e212eb	# kali firmware-nexmon 0.2
pkgdesc="ESP-NOW receiver over Nexmon brcmfmac monitor mode for Raspberry Pi 5"
url="https://gitlab.com/kalilinux/packages/brcmfmac-nexmon-dkms"
arch="aarch64"
license="GPL-2.0-only AND ISC AND LicenseRef-Broadcom-firmware"
depends="linux-rpi=$_kpkgver iw"
makedepends="linux-rpi-dev=$_kpkgver"
options="!strip"
source="brcmfmac-nexmon-$_drvcommit.tar.gz::https://gitlab.com/kalilinux/packages/brcmfmac-nexmon-dkms/-/archive/$_drvcommit/brcmfmac-nexmon-dkms-$_drvcommit.tar.gz
	firmware-nexmon-$_fwcommit.tar.gz::https://gitlab.com/kalilinux/packages/firmware-nexmon/-/archive/$_fwcommit/firmware-nexmon-$_fwcommit.tar.gz
	espnow.c
	espnow_frame.h
	Kbuild
	frame_test.c
	espnow.initd
	espnow.confd
	espnow-modprobe.conf
	"
builddir="$srcdir"
_kdir=/usr/src/linux-headers-$_krel
_drv="brcmfmac-nexmon-dkms-$_drvcommit"
_fw="firmware-nexmon-$_fwcommit"

prepare() {
	default_prepare
	mkdir -p espnow
	cp espnow.c espnow_frame.h Kbuild espnow/
}

build() {
	make -C "$_kdir" M="$srcdir/$_drv" modules
	make -C "$_kdir" M="$srcdir/espnow" modules
	${CC:-gcc} -Wall -Wextra -O2 -o frame_test frame_test.c
}

check() {
	./frame_test
	# modules must match the kernel they will be loaded into
	modinfo -F vermagic "$_drv"/brcmfmac.ko | grep -q "^$_krel "
	modinfo -F vermagic espnow/espnow.ko | grep -q "^$_krel "
}

package() {
	local fwdir="$pkgdir"/usr/lib/espnow/firmware/brcm ext

	install -Dm644 "$_drv"/brcmfmac.ko espnow/espnow.ko \
		-t "$pkgdir"/usr/lib/espnow/modules/

	# Nexmon monitor/injection firmware, under the names brcmfmac asks for on a Pi 5
	install -Dm644 "$_fw"/cypress/cyfmac43455-sdio-standard.bin "$fwdir"/brcmfmac43455-sdio.bin
	install -Dm644 "$_fw"/cypress/cyfmac43455-sdio.clm_blob "$fwdir"/brcmfmac43455-sdio.clm_blob
	install -Dm644 "$_fw"/brcm/brcmfmac43455-sdio.txt "$fwdir"/brcmfmac43455-sdio.txt
	for ext in bin clm_blob txt; do
		ln -s brcmfmac43455-sdio.$ext "$fwdir/brcmfmac43455-sdio.raspberrypi,5-model-b.$ext"
	done

	install -Dm755 "$srcdir"/espnow.initd "$pkgdir"/etc/init.d/espnow
	install -Dm644 "$srcdir"/espnow.confd "$pkgdir"/etc/conf.d/espnow
	install -Dm644 "$srcdir"/espnow-modprobe.conf "$pkgdir"/etc/modprobe.d/espnow-nexmon.conf
}
