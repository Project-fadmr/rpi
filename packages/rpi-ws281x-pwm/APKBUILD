# Contributor: slindauskands@gmail.com
# Pins documented in docs/pins.md - change them together.
pkgname=rpi-ws281x-pwm
pkgver=0.1.0
pkgrel=0
_kpkgver=6.12.115-r0		# linux-rpi package version
_krel=6.12.115-0-rpi		# matching kernel release (uname -r)
_pi5commit=1396df4f35a86de0f7e5eda91d94d4539eef1727	# jgarff/rpi_ws281x pi5 branch head, rp1_ws281x_pwm/
pkgdesc="WS281x PWM kernel module and device-tree overlay for the Raspberry Pi 5 RP1 (GPIO18, channel 2)"
url="https://github.com/jgarff/rpi_ws281x"
arch="aarch64"
license="GPL-2.0-only"
depends="linux-rpi=$_kpkgver"
makedepends="linux-rpi-dev=$_kpkgver dtc"
options="!strip"
source="rpi_ws281x-$_pi5commit.tar.gz::https://github.com/jgarff/rpi_ws281x/archive/$_pi5commit.tar.gz
	rp1_ws281x_pwm.dts
	rpi-ws281x-pwm.initd
	rpi-ws281x-pwm.confd
	"
builddir="$srcdir"
_kdir=/usr/src/linux-headers-$_krel
_src="$srcdir/rpi_ws281x-$_pi5commit/rp1_ws281x_pwm"

build() {
	# same compile as upstream dts.sh, with our overlay source
	dtc -@ -O dtb -o rp1_ws281x_pwm.dtbo rp1_ws281x_pwm.dts
	make -C "$_kdir" M="$_src" modules
}

check() {
	# module must match the kernel it will be loaded into
	modinfo -F vermagic "$_src"/rp1_ws281x_pwm.ko | grep -q "^$_krel "
	dtc -I dtb -O dts -o /dev/null rp1_ws281x_pwm.dtbo
}

package() {
	install -Dm644 "$_src"/rp1_ws281x_pwm.ko -t "$pkgdir"/usr/lib/rpi-ws281x-pwm/modules/
	install -Dm644 rp1_ws281x_pwm.dtbo -t "$pkgdir"/usr/share/rpi-ws281x-pwm/

	install -Dm755 "$srcdir"/rpi-ws281x-pwm.initd "$pkgdir"/etc/init.d/rpi-ws281x-pwm
	install -Dm644 "$srcdir"/rpi-ws281x-pwm.confd "$pkgdir"/etc/conf.d/rpi-ws281x-pwm
}
